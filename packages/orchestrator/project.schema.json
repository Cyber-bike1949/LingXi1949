{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lingxi1949.dev/schemas/orchestrator-project.schema.json",
  "title": "LingXi Orchestrator project configuration",
  "type": "object",
  "required": [
    "repository",
    "developmentBranchPattern",
    "commands",
    "runtime"
  ],
  "properties": {
    "repository": {
      "type": "string",
      "pattern": "^[^/\\s]+/[^/\\s]+$"
    },
    "defaultBranch": {
      "type": "string",
      "minLength": 1
    },
    "developmentBranchPattern": {
      "type": "string",
      "minLength": 1
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "runtime": {
      "type": "object",
      "required": [
        "agent",
        "workflows"
      ],
      "properties": {
        "remote": {
          "$ref": "#/$defs/remote"
        },
        "remotes": {
          "type": "object",
          "properties": {
            "development": {
              "$ref": "#/$defs/remote"
            },
            "test": {
              "$ref": "#/$defs/remote"
            }
          }
        },
        "agent": {
          "$ref": "#/$defs/agent"
        },
        "tester": {
          "$ref": "#/$defs/agent"
        },
        "workflows": {
          "type": "object",
          "required": [
            "required",
            "rc"
          ],
          "properties": {
            "required": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            },
            "rc": {
              "type": "object",
              "required": [
                "workflow",
                "required"
              ],
              "properties": {
                "workflow": {
                  "type": "string"
                },
                "required": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string"
                  }
                }
              },
              "additionalProperties": true
            }
          },
          "additionalProperties": true
        },
        "quota": {
          "type": "object",
          "properties": {
            "defaultWaitMs": {
              "type": "integer",
              "minimum": 60000
            },
            "maxWaitMs": {
              "type": "integer",
              "minimum": 60000
            },
            "maxTotalWaitMs": {
              "type": "integer",
              "minimum": 60000
            }
          },
          "additionalProperties": true
        },
        "notifications": {
          "type": "object",
          "properties": {
            "feishuWebhookEnv": {
              "type": "string",
              "pattern": "^[A-Z_][A-Z0-9_]*$"
            }
          },
          "additionalProperties": false
        },
        "sandbox": {
          "type": "object",
          "properties": { "enabled": { "type": "boolean" }, "provider": { "type": "string" } },
          "additionalProperties": true
        },
        "release": {
          "type": "object",
          "properties": {
            "autoAfterGate": {
              "type": "boolean"
            },
            "unit": {
              "enum": [
                "obsidian-plugin",
                "remote"
              ]
            },
            "required": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            },
            "approvedBy": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    }
  },
  "$defs": {
    "remote": {
      "type": "object",
      "required": [
        "lingxiCli",
        "session",
        "worktreeRoot"
      ],
      "properties": {
        "lingxiCli": {
          "type": "string",
          "minLength": 1
        },
        "session": {
          "type": "string",
          "minLength": 1
        },
        "resourceId": {
          "type": "string"
        },
        "worktreeRoot": {
          "type": "string",
          "minLength": 1
        },
        "repositoryRoot": {
          "type": "string"
        },
        "shellKind": {
          "enum": [
            "cmd",
            "posix"
          ]
        }
      },
      "additionalProperties": true
    },
    "agent": {
      "type": "object",
      "required": [
        "executable",
        "args"
      ],
      "properties": {
        "executable": {
          "type": "string",
          "minLength": 1
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "resumeArgs": { "type": "array", "items": { "type": "string" } },
        "resumeNativeSession": { "type": "boolean" },
        "target": {
          "enum": [
            "local",
            "remote"
          ]
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 1000
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
