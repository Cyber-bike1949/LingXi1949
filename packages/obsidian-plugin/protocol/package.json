{
  "name": "@termy/protocol",
  "version": "1.0.0",
  "private": true,
  "description": "Termy remote protocol: JSON Schema source of truth, fixtures and codegen",
  "type": "commonjs",
  "scripts": {
    "validate": "node tools/validate.js",
    "validate:openapi": "node tools/validate-openapi.js",
    "frames": "node tools/frame-codec.test.js",
    "generate": "node tools/generate-typescript.js && node tools/generate-rust.js",
    "generate:check": "node tools/generate-typescript.js && git diff --exit-code -- generated/",
    "typecheck": "node tools/typecheck-fixtures.js",
    "test": "node tools/validate.js && node tools/validate-openapi.js && node tools/frame-codec.test.js && node tools/generate-typescript.js && node tools/typecheck-fixtures.js",
    "bundle": "node tools/bundle-schema.js",
    "generate:rust": "node tools/generate-rust.js"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "yaml": "2.8.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "json-schema-to-typescript": "^15.0.4",
    "typescript": "^5.9.3"
  }
}
