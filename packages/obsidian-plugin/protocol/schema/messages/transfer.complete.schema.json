{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://termy.dev/protocol/1/messages/transfer.complete.schema.json",
  "title": "transfer.complete (Plugin -> Agent)",
  "$ref": "../control-envelope.schema.json",
  "type": "object",
  "properties": {
    "type": { "const": "transfer.complete" },
