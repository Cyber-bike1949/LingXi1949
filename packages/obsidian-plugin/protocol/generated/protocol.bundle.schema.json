{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://termy.dev/protocol/1/protocol.bundle.schema.json",
  "title": "ControlMessage",
  "description": "GENERATED bundle of protocol/schema/. Do not edit; run `npm run bundle` in protocol/.",
  "oneOf": [
    {
      "$ref": "#/$defs/AgentHeartbeatMessage"
    },
    {
      "$ref": "#/$defs/AgentHelloMessage"
    },
    {
      "$ref": "#/$defs/AgentHelloAckMessage"
    },
    {
      "$ref": "#/$defs/TerminalCloseMessage"
    },
    {
      "$ref": "#/$defs/TerminalErrorMessage"
    },
    {
      "$ref": "#/$defs/TerminalOpenMessage"
    },
    {
      "$ref": "#/$defs/TerminalOpenedMessage"
    },
    {
      "$ref": "#/$defs/TerminalResizeMessage"
    },
    {
      "$ref": "#/$defs/TerminalShellEventMessage"
    },
    {
      "$ref": "#/$defs/TransferAbortMessage"
    },
    {
      "$ref": "#/$defs/TransferAcceptedMessage"
    },
    {
      "$ref": "#/$defs/TransferCompleteMessage"
    },
    {
      "$ref": "#/$defs/TransferCreditMessage"
    },
    {
      "$ref": "#/$defs/TransferFileEndMessage"
    },
    {
      "$ref": "#/$defs/TransferResultMessage"
    },
    {
      "$ref": "#/$defs/TransferStartMessage"
    }
  ],
  "$defs": {
    "Uuid": {
      "title": "Uuid",
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "description": "Lowercase hyphenated UUID."
    },
    "UuidOrNull": {
      "title": "UuidOrNull",
      "oneOf": [
        {
          "$ref": "#/$defs/Uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "DateTime": {
      "title": "DateTime",
      "type": "string",
      "format": "date-time",
      "description": "UTC RFC 3339 timestamp."
    },
    "Semver": {
      "title": "Semver",
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z-.]+)?(?:\\+[0-9A-Za-z-.]+)?$"
    },
    "Platform": {
      "title": "Platform",
      "type": "string",
      "enum": [
        "windows-x64",
        "ubuntu-x64"
      ]
    },
    "Capability": {
      "title": "Capability",
      "type": "string",
      "enum": [
        "terminal",
        "file-transfer"
      ]
    },
    "ErrorCode": {
      "title": "ErrorCode",
      "type": "string",
      "enum": [
        "AUTH_EXPIRED",
        "AUTH_INVALID",
        "PAIRING_CODE_INVALID",
        "DEVICE_FORBIDDEN",
        "DEVICE_OFFLINE",
        "DEVICE_BUSY",
        "SHELL_START_FAILED",
        "RELAY_DISCONNECTED",
        "INVALID_DROP",
        "INVALID_PATH",
        "WRITE_FAILED",
        "TRANSFER_FAILED",
        "QUOTA_EXCEEDED",
        "RATE_LIMITED",
        "BACKPRESSURE_LIMIT",
        "SESSION_TIMEOUT",
        "PROTOCOL_ERROR",
        "INTERNAL_ERROR"
      ]
    },
    "SafeRelativePath": {
      "title": "SafeRelativePath",
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "description": "Vault-relative path. Always '/'-separated. Structural safety (no '..', no drive letter, no UNC root, no absolute form, no empty segment, no NUL) is enforced in code per doc 10.3; maxLength here counts UTF-16 code units and is an upper bound only, the 1024-byte UTF-8 limit is enforced in code.",
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*//)(?!.*(^|/)\\.\\.(/|$))(?!.*(^|/)\\.(/|$))[^\\u0000]*[^\\u0000/]$"
    },
    "Cols": {
      "title": "Cols",
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    },
    "Rows": {
      "title": "Rows",
      "type": "integer",
      "minimum": 1,
      "maximum": 500
    },
    "FileIndex": {
      "title": "FileIndex",
      "type": "integer",
      "minimum": 0,
      "maximum": 255
    },
    "FileSize": {
      "title": "FileSize",
      "type": "integer",
      "minimum": 0,
      "maximum": 67108864,
      "description": "Per-file byte limit, 64 MiB (doc 4.12 / 8.4)."
    },
    "FileEntry": {
      "title": "FileEntry",
      "type": "object",
      "properties": {
        "index": {
          "$ref": "#/$defs/FileIndex"
        },
        "relativePath": {
          "$ref": "#/$defs/SafeRelativePath"
        },
        "size": {
          "$ref": "#/$defs/FileSize"
        }
      },
      "required": [
        "index",
        "relativePath",
        "size"
      ],
      "additionalProperties": false
    },
    "ShellEventName": {
      "title": "ShellEventName",
      "type": "string",
      "enum": [
        "prompt_start",
        "command_start",
        "command_executed",
        "command_end"
      ],
      "description": "Mirrors Termy's local ShellEventType exactly, so the plugin can hand payload straight to its existing shell-event handler."
    },
    "TerminalCloseReason": {
      "title": "TerminalCloseReason",
      "type": "string",
      "enum": [
        "user",
        "peer_disconnected",
        "shell_exited",
        "error"
      ]
    },
    "ShellEventSource": {
      "title": "ShellEventSource",
      "type": "string",
      "enum": [
        "osc133",
        "osc633"
      ],
      "description": "Which shell-integration sequence produced the event, mirroring Termy's local ShellEventSource."
    },
    "AgentHeartbeatMessage": {
      "title": "AgentHeartbeatMessage",
      "type": "object",
      "description": "payload.timestamp is diagnostic only. Online/offline decisions use the server monotonic clock (doc 11.1).",
      "properties": {
        "protocolVersion": {
          "type": "integer",
          "enum": [
            1
          ]
        },
        "type": {
          "enum": [
            "agent.heartbeat"
          ]
        },
        "requestId": {
          "type": "null"
        },
        "deviceId": {
          "$ref": "#/$defs/Uuid"
        },
        "sessionId": {
          "type": "null"
        },
        "payload": {
          "type": "object",
          "properties": {
            "timestamp": {
              "$ref": "#/$defs/DateTime"
            }
          },
          "required": [
            "timestamp"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "protocolVersion",
        "type",
        "requestId",
        "deviceId",
        "sessionId",
        "payload"
      ],
      "additionalProperties": false
    },
    "AgentHelloMessage": {
      "title": "AgentHelloMessage",
      "type": "object",
      "properties": {
        "protocolVersion": {
          "type": "integer",
          "enum": [
            1
          ]
        },
        "type": {
          "enum": [
            "agent.hello"
          ]
        },
        "requestId": {
          "$ref": "#/$defs/Uuid"
        },
        "deviceId": {
          "$ref": "#/$defs/Uuid"
        },
        "sessionId": {
          "type": "null"
        },
        "payload": {
          "type": "object",
          "properties": {
            "agentVersion": {
              "$ref": "#/$defs/Semver"
            },
            "platform": {
              "$ref": "#/$defs/Platform"
            },
            "capabilities": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Capability"
              },
              "minItems": 1,
              "maxItems": 2,
              "uniqueItems": true
            }
          },
          "required": [
            "agentVersion",
            "platform",
            "capabilities"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "protocolVersion",
        "type",
        "requestId",
        "deviceId",
        "sessionId",
        "payload"
      ],
      "additionalProperties": false
    },
    "AgentHelloAckMessage": {
      "title": "AgentHelloAckMessage",
      "type": "object",
      "properties": {
        "protocolVersion": {
          "type": "integer",
          "enum": [
            1
          ]
        },
        "type": {
          "enum": [
            "agent.helloAck"
          ]
        },
        "requestId": {
          "$ref": "#/$defs/Uuid"
        },
        "deviceId": {
          "$ref": "#/$defs/Uuid"
        },
        "sessionId": {
          "type": "null"
        },
        "payload": {
          "type": "object",
          "properties": {
            "serverTime": {
              "$ref": "#/$defs/DateTime"
            },
            "heartbeatIntervalMs": {
              "type": "integer",
              "enum": [
                20000
              ]
            }
          },
          "required": [
            "serverTime",
            "heartbeatIntervalMs"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "protocolVersion",
        "type",
        "requestId",
        "deviceId",
        "sessionId",
        "payload"
      ],
      "additionalProperties": false
    },
    "TerminalCloseMessage": {
      "title": "TerminalCloseMessage",
      "type": "object",
      "description": "Plugin sends it to end a session (reason=user). Agent sends it when the shell exits (reason=shell_exited, exitCode set) or the peer went away.",
      "properties": {
        "protocolVersion": {
          "type": "integer",
          "enum": [
            1
          ]
        },
        "type": {
          "enum": [
            "terminal.close"
          ]
        },
        "requestId": {
          "type": "null"
        },
        "deviceId": {
          "$ref": "#/$defs/Uuid"
        },
        "sessionId": {
          "$ref": "#/$defs/Uuid"
        },
        "payload": {
          "type": "object",
          "properties": {
            "reason": {
              "$ref": "#/$defs/TerminalCloseReason"
            },
            "exitCode": {
              "oneOf": [
                {
                  "type": "integer",
                  "minimum": -2147483648,
                  "maximum": 2147483647
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "reason",
            "exitCode"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "protocolVersion",
        "type",
        "requestId",
        "deviceId",
        "sessionId",
        "payload"
      ],
      "additionalProperties": false
    },
    "TerminalErrorMessage": {
      "title": "TerminalErrorMessage",
      "type": "object",
      "description": "sessionId is null when the failure happens before a session exists (DEVICE_OFFLINE, DEVICE_BUSY, SHELL_START_FAILED in response to terminal.open); requestId echoes the failed request when there is one. message must be redacted per doc 8.8.6.",
      "properties": {
        "protocolVersion": {
          "type": "integer",
          "enum": [
            1
          ]
        },
        "type": {
          "enum": [
            "terminal.error"
          ]
        },
        "requestId": {
          "$ref": "#/$defs/UuidOrNull"
        },
        "deviceId": {
          "$ref": "#/$defs/Uuid"
        },
        "sessionId": {
          "$ref": "#/$defs/UuidOrNull"
        },
        "payload": {
          "type": "object",
          "properties": {
            "code": {
              "$ref": "#/$defs/ErrorCode"
            },
            "message": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            }
          },
          "required": [
            "code",
            "message"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "protocolVersion",
        "type",
        "requestId",
        "deviceId",
        "sessionId",
        "payload"
      ],
      "additionalProperties": false
    },
    "TerminalOpenMessage": {
      "title": "TerminalOpenMessage",
      "type": "object",
      "properties": {
        "protocolVersion": {
          "type": "integer",
          "enum": [
            1
          ]
        },
        "type": {
          "enum": [
            "terminal.open"
          ]
        },
        "requestId": {
          "$ref": "#/$defs/Uuid"
        },
        "deviceId": {
          "$ref": "#/$defs/Uuid"
        },
        "sessionId": {
          "type": "null"
        },
        "payload": {
          "type": "object",
          "properties": {
            "cols": {
              "$ref": "#/$defs/Cols"
            },
            "rows": {
              "$ref": "#/$defs/Rows"
            }
          },
          "required": [
            "cols",
            "rows"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "protocolVersion",
        "type",
        "requestId",
        "deviceId",
        "sessionId",
        "payload"
      ],
      "additionalProperties": false
    },
    "TerminalOpenedMessage": {
      "title": "TerminalOpenedMessage",
      "type": "object",
      "description": "Direct response to terminal.open: requestId matches, and the envelope carries the sessionId minted by the Agent (doc 8.8.3).",
      "properties": {
        "protocolVersion": {
          "type": "integer",
          "enum": [
            1
          ]
        },
        "type": {
          "enum": [
            "terminal.opened"
          ]
        },
        "requestId": {
          "$ref": "#/$defs/Uuid"
        },
        "deviceId": {
          "$ref": "#/$defs/Uuid"
        },
        "sessionId": {
          "$ref": "#/$defs/Uuid"
        },
        "payload": {
          "type": "object",
          "properties": {
            "shell": {
              "type": "string",
              "minLength": 1,
              "maxLength": 260
            }
          },
          "required": [
            "shell"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "protocolVersion",
        "type",
        "requestId",
        "deviceId",
        "sessionId",
        "payload"
      ],
      "additionalProperties": false
    },
    "TerminalResizeMessage": {
      "title": "TerminalResizeMessage",
      "type": "object",
      "properties": {
        "protocolVersion": {
          "type": "integer",
          "enum": [
            1
          ]
        },
        "type": {
          "enum": [
            "terminal.resize"
          ]
        },
        "requestId": {
          "type": "null"
        },
        "deviceId": {
          "$ref": "#/$defs/Uuid"
        },
        "sessionId": {
          "$ref": "#/$defs/Uuid"
        },
        "payload": {
          "type": "object",
          "properties": {
            "cols": {
              "$ref": "#/$defs/Cols"
            },
            "rows": {
              "$ref": "#/$defs/Rows"
            }
          },
          "required": [
            "cols",
            "rows"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "protocolVersion",
        "type",
        "requestId",
        "deviceId",
        "sessionId",
        "payload"
      ],
      "additionalProperties": false
    },
    "TerminalShellEventMessage": {
      "title": "TerminalShellEventMessage",
      "type": "object",
      "description": "Shell integration events produced by the Agent's port of rust-servers/src/pty/osc_scanner.rs. The payload is shape-identical to Termy's local ShellEvent so the plugin can forward it to the existing handler unchanged. cwd is deliberately absent: the plugin derives it by parsing the xterm buffer (extractCwdFromPromptLines), and the terminal output bytes that parsing needs are forwarded verbatim, so cwd tracking already works in remote mode without protocol support.",
      "properties": {
        "protocolVersion": {
          "type": "integer",
          "enum": [
            1
          ]
        },
        "type": {
          "enum": [
            "terminal.shellEvent"
          ]
        },
        "requestId": {
          "type": "null"
        },
        "deviceId": {
          "$ref": "#/$defs/Uuid"
        },
        "sessionId": {
          "$ref": "#/$defs/Uuid"
        },
        "payload": {
          "type": "object",
          "properties": {
            "type": {
              "$ref": "#/$defs/ShellEventName"
            },
            "source": {
              "$ref": "#/$defs/ShellEventSource"
            },
            "exitCode": {
              "oneOf": [
                {
                  "type": "integer",
                  "minimum": -2147483648,
                  "maximum": 2147483647
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "type",
            "source",
            "exitCode"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "protocolVersion",
        "type",
        "requestId",
        "deviceId",
        "sessionId",
        "payload"
      ],
      "additionalProperties": false
    },
    "TransferAbortMessage": {
      "title": "TransferAbortMessage",
      "type": "object",
      "description": "Plugin-side abort: read failure, user cancel, or leaving remote mode. The Agent stops accepting frames for this transferId, closes the open file handle and replies transfer.result with success=false. Partial files may remain.",
      "properties": {
        "protocolVersion": {
          "type": "integer",
          "enum": [
            1
          ]
        },
        "type": {
          "enum": [
            "transfer.abort"
          ]
        },
        "requestId": {
          "type": "null"
        },
        "deviceId": {
          "$ref": "#/$defs/Uuid"
        },
        "sessionId": {
          "type": "null"
        },
        "payload": {
          "type": "object",
          "properties": {
            "transferId": {
              "$ref": "#/$defs/Uuid"
            },
            "code": {
              "$ref": "#/$defs/ErrorCode"
            }
          },
          "required": [
            "transferId",
            "code"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "protocolVersion",
        "type",
        "requestId",
        "deviceId",
        "sessionId",
        "payload"
      ],
      "additionalProperties": false
    },
    "TransferAcceptedMessage": {
      "title": "TransferAcceptedMessage",
      "type": "object",
      "description": "Direct response to transfer.start. grantedBytes is the initial credit window (doc 8.6): the plugin may not send file frames before this message, and never more than grantedBytes cumulative bytes.",
      "properties": {
        "protocolVersion": {
          "type": "integer",
          "enum": [
            1
          ]
        },
        "type": {
          "enum": [
            "transfer.accepted"
          ]
        },
        "requestId": {
          "$ref": "#/$defs/Uuid"
        },
        "deviceId": {
          "$ref": "#/$defs/Uuid"
        },
        "sessionId": {
          "type": "null"
        },
        "payload": {
          "type": "object",
          "properties": {
            "transferId": {
              "$ref": "#/$defs/Uuid"
            },
            "grantedBytes": {
              "type": "integer",
              "minimum": 262144,
              "maximum": 4194304
            }
          },
          "required": [
            "transferId",
            "grantedBytes"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "protocolVersion",
        "type",
        "requestId",
        "deviceId",
        "sessionId",
        "payload"
      ],
      "additionalProperties": false
    },
    "TransferCompleteMessage": {
      "title": "TransferCompleteMessage",
      "type": "object",
      "properties": {
        "protocolVersion": {
          "type": "integer",
          "enum": [
            1
          ]
        },
        "type": {
          "enum": [
            "transfer.complete"
          ]
        },
        "requestId": {
          "type": "null"
        },
        "deviceId": {
          "$ref": "#/$defs/Uuid"
        },
        "sessionId": {
          "type": "null"
        },
        "payload": {
          "type": "object",
          "properties": {
            "transferId": {
              "$ref": "#/$defs/Uuid"
            }
          },
          "required": [
            "transferId"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "protocolVersion",
        "type",
        "requestId",
        "deviceId",
        "sessionId",
        "payload"
      ],
      "additionalProperties": false
    },
    "TransferCreditMessage": {
      "title": "TransferCreditMessage",
      "type": "object",
      "description": "Credit top-up, sent after every 1 MiB flushed to disk. grantedBytes is the CUMULATIVE authorisation for the whole transfer and must increase monotonically; the receiver keeps the maximum it has seen. Upper bound is the 256 MiB per-transfer cap.",
      "properties": {
        "protocolVersion": {
          "type": "integer",
          "enum": [
            1
          ]
        },
        "type": {
          "enum": [
            "transfer.credit"
          ]
        },
        "requestId": {
          "type": "null"
        },
        "deviceId": {
          "$ref": "#/$defs/Uuid"
        },
        "sessionId": {
          "type": "null"
        },
        "payload": {
          "type": "object",
          "properties": {
            "transferId": {
              "$ref": "#/$defs/Uuid"
            },
            "grantedBytes": {
              "type": "integer",
              "minimum": 262144,
              "maximum": 268435456
            }
          },
          "required": [
            "transferId",
            "grantedBytes"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "protocolVersion",
        "type",
        "requestId",
        "deviceId",
        "sessionId",
        "payload"
      ],
      "additionalProperties": false
    },
    "TransferFileEndMessage": {
      "title": "TransferFileEndMessage",
      "type": "object",
      "description": "Marks the end of one file. sentSize is authoritative for the success check (doc 10.4); a zero value means an empty file, for which no chunk frame is sent and the Agent must still create and close a 0-byte file.",
      "properties": {
        "protocolVersion": {
          "type": "integer",
          "enum": [
            1
          ]
        },
        "type": {
          "enum": [
            "transfer.fileEnd"
          ]
        },
        "requestId": {
          "type": "null"
        },
        "deviceId": {
          "$ref": "#/$defs/Uuid"
        },
        "sessionId": {
          "type": "null"
        },
        "payload": {
          "type": "object",
          "properties": {
            "transferId": {
              "$ref": "#/$defs/Uuid"
            },
            "fileIndex": {
              "$ref": "#/$defs/FileIndex"
            },
            "sentSize": {
              "$ref": "#/$defs/FileSize"
            }
          },
          "required": [
            "transferId",
            "fileIndex",
            "sentSize"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "protocolVersion",
        "type",
        "requestId",
        "deviceId",
        "sessionId",
        "payload"
      ],
      "additionalProperties": false
    },
    "TransferResultMessage": {
      "title": "TransferResultMessage",
      "type": "object",
      "description": "Terminal outcome of one transfer. Not a direct response to transfer.start (that is transfer.accepted), so requestId is null and correlation is by transferId. code is null exactly when success is true - a cross-field rule enforced in code.",
      "properties": {
        "protocolVersion": {
          "type": "integer",
          "enum": [
            1
          ]
        },
        "type": {
          "enum": [
            "transfer.result"
          ]
        },
        "requestId": {
          "type": "null"
        },
        "deviceId": {
          "$ref": "#/$defs/Uuid"
        },
        "sessionId": {
          "type": "null"
        },
        "payload": {
          "type": "object",
          "properties": {
            "transferId": {
              "$ref": "#/$defs/Uuid"
            },
            "success": {
              "type": "boolean"
            },
            "code": {
              "oneOf": [
                {
                  "$ref": "#/$defs/ErrorCode"
                },
                {
                  "type": "null"
                }
