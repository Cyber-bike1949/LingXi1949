# Upstream keeps docs/ out of the tree as a personal scratch area.
# development.md/development_ZH.md under docs/ are deliverable documentation
# and must be tracked, so exclude the contents rather than the directory -
# git cannot re-include a path whose parent directory is itself excluded.
docs/*
!docs/development.md
!docs/development_ZH.md
!docs/remote-tasks-first-run.zh-CN.md

# Personal scratch notes (not part of the plugin)
t.md
new_t.md
