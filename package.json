{
  "name": "lingxi-monorepo",
  "version": "5.0.2",
  "private": true,
  "packageManager": "pnpm@10.33.4",
  "scripts": {
    "build:plugin": "pnpm --dir packages/obsidian-plugin build",
    "test:plugin": "pnpm --dir packages/obsidian-plugin test:terminal && pnpm --dir packages/obsidian-plugin test:remote && pnpm --dir packages/obsidian-plugin test:scripts",
    "lint:plugin": "pnpm --dir packages/obsidian-plugin lint:obsidian",
    "build:remote": "pnpm --dir packages/remote build",
    "test:remote": "pnpm --dir packages/remote test",
    "test:e2e:remote": "pnpm --dir packages/remote test:e2e",
    "build": "pnpm build:plugin && pnpm build:remote",
    "test": "pnpm test:plugin && pnpm test:remote"
  }
}
